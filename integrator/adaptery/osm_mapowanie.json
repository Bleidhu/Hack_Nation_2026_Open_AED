{
  "wersja": "2.0",
  "typ_zrodla": "osm",
  "walidacja": "luzna",
  "opis": "OpenStreetMap (emergency=defibrillator): tagi → kolumny wzorca v2. Licencja ODbL: domyślnie tylko tryb lokalny i porównania. Cudze dane w formacie OSM: ta sama ścieżka z własną --licencja.",
  "licencja_zrodla": "ODbL 1.0",
  "ignorowane_tagi": ["emergency"],
  "kolumny": {
    "id_zrodlowe": {"z": "@id"},
    "nazwa_lokalizacji": {"z": ["name", "operator", "defibrillator:location:pl", "defibrillator:location", "description"]},
    "opis_lokalizacji": {"z": ["defibrillator:location:pl", "defibrillator:location", "description"]},
    "szerokosc_geograficzna": {"z": "__lat"},
    "dlugosc_geograficzna": {"z": "__lon"},
    "miejscowosc": {"z": "addr:city"},
    "kod_pocztowy": {"z": "addr:postcode"},
    "nazwa_ulicy": {"z": "addr:street"},
    "numer_budynku": {"z": "addr:housenumber"},
    "wewnatrz_budynku": {"z": "indoor", "mapa": {"yes": "true", "no": "false"}},
    "kondygnacja": {"z": "level"},
    "typ_dostepu": {"z": "access", "mapa": {"yes": "publiczny", "permissive": "publiczny", "customers": "ograniczony", "permit": "ograniczony", "private": "prywatny", "no": "prywatny"}},
    "godziny_dostepnosci": {"z": "opening_hours"},
    "dostepny_24_7": {"z": "opening_hours", "mapa": {"24/7": "true", "*": "false"}},
    "dysponent_nazwa": {"z": "operator"},
    "telefon_kontaktowy": {"z": ["phone", "emergency:phone", "contact:phone"]},
    "email_kontaktowy": {"z": ["email", "contact:email"]},
    "producent": {"z": "manufacturer"},
    "model": {"z": "model"},
    "data_weryfikacji": {"z": "check_date"},
    "zrodlo_url": {"z": "__url"},
    "data_aktualizacji": {"z": "__data"},
    "zrodlo_danych": {"stala": "openstreetmap"},
    "poziom_weryfikacji": {"stala": "niezweryfikowany"}
  }
}
