{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Plik mapowania kolumn na wzorzec AED",
  "type": "object",
  "required": [
    "kolumny"
  ],
  "properties": {
    "wersja": {
      "type": "string"
    },
    "opis": {
      "type": "string"
    },
    "organizacja_id": {
      "type": "string"
    },
    "licencja_zrodla": {
      "type": "string",
      "description": "np. ODbL-1.0 dla OSM – wyklucza ze zbioru krajowego CC0"
    },
    "domyslne": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "kolumny": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "id_aed",
          "id_zrodlowe",
          "nazwa_lokalizacji",
          "wojewodztwo",
          "powiat",
          "gmina",
          "kod_terc",
          "miejscowosc",
          "kod_simc",
          "kod_pocztowy",
          "cecha_ulicy",
          "nazwa_ulicy",
          "kod_ulic",
          "numer_budynku",
          "numer_lokalu",
          "adres_uniwersalny",
          "szerokosc_geograficzna",
          "dlugosc_geograficzna",
          "opis_lokalizacji",
          "wewnatrz_budynku",
          "kondygnacja",
          "typ_dostepu",
          "dostepny_24_7",
          "godziny_dostepnosci",
          "zabezpieczenie",
          "instrukcja_dostepu",
          "status_urzadzenia",
          "producent",
          "model",
          "elektrody_pediatryczne",
          "data_waznosci_elektrod",
          "data_waznosci_baterii",
          "data_ostatniego_przegladu",
          "dysponent_nazwa",
          "dysponent_regon",
          "telefon_kontaktowy",
          "email_kontaktowy",
          "zrodlo_danych",
          "zrodlo_url",
          "poziom_weryfikacji",
          "data_weryfikacji",
          "data_aktualizacji",
          "zdjecie_url",
          "uwagi",
          "organizacja_id",
          "id_obszaru",
          "id_pojazdu"
        ]
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "z": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ],
            "description": "Kolumna źródła (lub lista – pierwsza niepusta)"
          },
          "stala": {
            "type": "string",
            "description": "Wartość stała dla wszystkich wierszy"
          },
          "mapa": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "Przekodowanie wartości; klucz * = domyślna"
          },
          "regex": {
            "type": "string",
            "description": "Wyrażenie regularne; pierwsza grupa = wartość"
          }
        },
        "oneOf": [
          {
            "required": [
              "z"
            ]
          },
          {
            "required": [
              "stala"
            ]
          }
        ]
      }
    }
  }
}
