+
+
+@pytest.mark.feat_main_aed
+@pytest.mark.parametrize(
+    ("customfields", "expected"),
+    [
+        ({"zestawienie": "AED-krajowe"}, True),
+        ({"Zestawienie": "aed-krajowe", "standard": "AED"}, True),
+        ({"standard": "AED"}, False),
+        (None, False),
+    ],
+)
+def test_is_main_aed_dataset(customfields, expected):
