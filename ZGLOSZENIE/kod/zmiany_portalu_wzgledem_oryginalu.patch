+    is_aed_dataset,
+    is_main_aed_dataset,
+)
+from mcod.resources.models import Resource
+from mcod.resources.tasks import process_resource_file_data_task
+
+AGGREGATED_AT = "2026-11-22T04:15:00"
+LEGIONOWO_ROWS = 24
