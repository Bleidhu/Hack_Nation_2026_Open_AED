index 0000000..3759165
--- /dev/null
+++ b/portal/backend/mcod/resources/aed_dedup.py
@@ -0,0 +1,192 @@
+"""
+Deduplikacja wierszy Wykazu AED: to samo urządzenie zgłoszone przez dwóch dostawców (albo dwa razy w jednym pliku)
+ma trafić do wykazu raz.
+
+Moduł nie importuje Django ani ORM: przyjmuje i zwraca `DataFrame` (kolumny zasobu zbiorczego), więc działa też
+w `demo/sprawdz.py`. Reguły (kolejność ma znaczenie):
+
+1. **Klucz mocny: numer seryjny.** Ten sam znormalizowany numer seryjny oznacza to samo urządzenie, chyba że oba wiersze
+   podają producenta i producenci się różnią (numery seryjne różnych firm mogą się powtarzać).
+2. **Klucz słaby, tylko między różnymi zasobami:** punkty w odległości do 30 m, bez sprzeczności
+   (różne numery seryjne, różni producenci, różne modele albo różne kondygnacje oznaczają różne urządzenia) i z zgodnością:
+   - ten sam producent albo ten sam model (marka), albo
+   - gdy brakuje marki: odległość do 10 m i ta sama znormalizowana nazwa lokalizacji.
+   W obrębie jednego pliku dwa AED w jednym miejscu bez numerów seryjnych to dwa urządzenia, więc nie są łączone.
+3. **Który wiersz zostaje:** wyższy poziom weryfikacji, potem nowsza `data_aktualizacji`, potem wcześniejszy w kolejności.
+   Puste `producent`, `model` i `numer_seryjny` zachowanego wiersza uzupełniamy z duplikatów.
+
+Wynik zawiera listę par (`zachowany`, `pominiety`, `powod`), którą portal zapisuje w statystykach i logu.
+"""
+
+import math
+import re
+import unicodedata
+from typing import Any, Dict, List, Optional, Tuple
+
+import pandas as pd
+
+SERIAL_PLACEHOLDERS = {"brak", "nieznany", "nieznane", "nd", "na", "none", "null", "unknown", "bd"}
+MIN_SERIAL_LENGTH = 4
+WEAK_DISTANCE_M = 30.0
+NAME_DISTANCE_M = 10.0
+VERIFICATION_RANK = {"zweryfikowany_w_terenie": 2, "zweryfikowany_przez_dysponenta": 1}
+FILL_COLUMNS = ("producent", "model", "numer_seryjny")
+REASON_SERIAL = "numer_seryjny"
+REASON_BRAND = "marka_model_i_lokalizacja"
+REASON_NAME = "nazwa_i_lokalizacja"
+
+
+def _plain(value: Any) -> str:
+    text = unicodedata.normalize("NFKD", str(value if value is not None else "").replace("ł", "l").replace("Ł", "L"))
+    return re.sub(r"[^a-z0-9]", "", "".join(c for c in text if not unicodedata.combining(c)).lower())
+
+
+def normalize_serial(value: Any) -> str:
+    """Znormalizowany numer seryjny albo pusty tekst, gdy to brak danych (np. „brak”, „-”, za krótki)."""
+    serial = _plain(value)
+    if serial in SERIAL_PLACEHOLDERS or len(serial) < MIN_SERIAL_LENGTH or len(set(serial)) == 1:
+        return ""
+    return serial
+
+
+def _float(value: Any) -> Optional[float]:
+    try:
+        return float(str(value).strip())
+    except ValueError:
+        return None
+
+
+def distance_m(lat1: float, lon1: float, lat2: float, lon2: float) -> float:
+    p1, p2 = math.radians(lat1), math.radians(lat2)
+    a = math.sin((p2 - p1) / 2) ** 2 + math.cos(p1) * math.cos(p2) * math.sin(math.radians(lon2 - lon1) / 2) ** 2
+    return 12742000.0 * math.asin(math.sqrt(a))
+
+
+class _Row:
+    def __init__(self, index: int, record: Dict[str, Any]):
+        self.index = index
+        self.record = record
+        self.serial = normalize_serial(record.get("numer_seryjny"))
+        self.brand = _plain(record.get("producent"))
+        self.model = _plain(record.get("model"))
+        self.name = _plain(record.get("nazwa_lokalizacji"))
+        self.floor = str(record.get("kondygnacja") or "").strip()
+        self.resource = str(record.get("id_zasobu_zrodlowego") or "")
+        self.lat = _float(record.get("szerokosc_geograficzna"))
+        self.lon = _float(record.get("dlugosc_geograficzna"))
+        self.rank = VERIFICATION_RANK.get(str(record.get("poziom_weryfikacji") or ""), 0)
+        self.updated = str(record.get("data_aktualizacji") or "")
+
+    @property
+    def best_key(self) -> Tuple[int, str, int]:
+        return self.rank, self.updated, -self.index
+
+
+def _conflict(a: str, b: str) -> bool:
+    return bool(a) and bool(b) and a != b
+
+
+def _strong_match(a: _Row, b: _Row) -> bool:
+    return bool(a.serial) and a.serial == b.serial and not _conflict(a.brand, b.brand)
+
+
+def _weak_match(a: _Row, b: _Row) -> Optional[str]:
+    if a.resource == b.resource or None in (a.lat, a.lon, b.lat, b.lon):
+        return None
+    if _conflict(a.serial, b.serial) or _conflict(a.brand, b.brand) or _conflict(a.model, b.model) or _conflict(a.floor, b.floor):
+        return None
+    meters = distance_m(a.lat, a.lon, b.lat, b.lon)
+    if meters > WEAK_DISTANCE_M:
+        return None
+    if (a.brand and a.brand == b.brand) or (a.model and a.model == b.model):
+        return REASON_BRAND
+    if not (a.brand and b.brand) and meters <= NAME_DISTANCE_M and a.name and a.name == b.name:
+        return REASON_NAME
+    return None
+
+
+def _serial_pairs(rows: List[_Row]) -> set:
+    by_serial: Dict[str, List[_Row]] = {}
+    for row in rows:
+        if row.serial:
+            by_serial.setdefault(row.serial, []).append(row)
+    return {(a.index, b.index) for group in by_serial.values() for i, a in enumerate(group) for b in group[i + 1 :]}
+
+
+def _grid_pairs(rows: List[_Row]) -> set:
+    """Pary z sąsiednich komórek siatki ~100 m, żeby nie porównywać wszystkich ze wszystkimi."""
+    grid: Dict[Tuple[int, int], List[_Row]] = {}
+    for row in rows:
+        if row.lat is not None and row.lon is not None:
+            grid.setdefault((int(row.lat * 1000), int(row.lon * 1000)), []).append(row)
+    pairs = set()
+    for (cx, cy), group in grid.items():
+        near = [r for dx in (-1, 0, 1) for dy in (-1, 0, 1) for r in grid.get((cx + dx, cy + dy), [])]
+        pairs.update((a.index, b.index) for a in group for b in near if a.index < b.index)
+    return pairs
+
+
+def _candidate_pairs(rows: List[_Row]):
+    for i, j in sorted(_serial_pairs(rows) | _grid_pairs(rows)):
+        yield rows[i], rows[j]
+
+
+def _group_rows(rows: List[_Row]) -> Tuple[Dict[int, List[_Row]], Dict[int, Tuple[int, str]]]:
+    """Grupy tego samego urządzenia (union-find) i powód połączenia każdego wiersza."""
+    parent = list(range(len(rows)))
+    edges: Dict[int, Tuple[int, str]] = {}
+
+    def find(x: int) -> int:
+        while parent[x] != x:
+            parent[x] = parent[parent[x]]
+            x = parent[x]
+        return x
+
+    for a, b in _candidate_pairs(rows):
+        reason = REASON_SERIAL if _strong_match(a, b) else _weak_match(a, b)
+        if reason and find(a.index) != find(b.index):
+            parent[find(b.index)] = find(a.index)
+            edges[b.index] = (a.index, reason)
+            edges.setdefault(a.index, (b.index, reason))
+    groups: Dict[int, List[_Row]] = {}
+    for row in rows:
+        groups.setdefault(find(row.index), []).append(row)
+    return groups, edges
+
+
+def _fill_values(keeper: _Row, members: List[_Row]) -> Dict[str, Any]:
+    fill = {}
+    for column in FILL_COLUMNS:
+        if not str(keeper.record.get(column) or "").strip():
+            donor = next((m.record.get(column) for m in members if str(m.record.get(column) or "").strip()), None)
+            if donor:
+                fill[column] = donor
+    return fill
+
+
+def deduplicate_rows(df: pd.DataFrame) -> Tuple[pd.DataFrame, List[Dict[str, str]]]:
+    """Zwraca ramkę bez duplikatów (kolejność zachowanych wierszy bez zmian) i listę usuniętych duplikatów."""
+    if df.empty:
+        return df, []
+    rows = [_Row(i, rec) for i, rec in enumerate(df.to_dict("records"))]
+    groups, edges = _group_rows(rows)
+    drop, duplicates = set(), []
+    result = df.copy()
+    for members in groups.values():
+        if len(members) == 1:
+            continue
+        keeper = max(members, key=lambda r: r.best_key)
+        for column, value in _fill_values(keeper, members).items():
+            result.iat[keeper.index, result.columns.get_loc(column)] = value
+        for member in members:
+            if member is not keeper:
+                drop.add(member.index)
+                reason = edges.get(member.index, (0, REASON_SERIAL))[1]
+                duplicates.append(
+                    {
+                        "zachowany": str(keeper.record.get("id_aed", keeper.index)),
+                        "pominiety": str(member.record.get("id_aed", member.index)),
+                        "powod": reason,
+                    }
+                )
+    return result.drop(index=result.index[sorted(drop)]).reset_index(drop=True), duplicates
diff --git a/portal/backend/mcod/resources/aed_import.py b/portal/backend/mcod/resources/aed_import.py
new file mode 100644
index 0000000..a470abf
--- /dev/null
+++ b/portal/backend/mcod/resources/aed_import.py
@@ -0,0 +1,159 @@
+"""
+Import zewnętrznych danych AED do portalu: opis zbioru w XML → walidacja XSD → CSV → zgodność md5 → zbiór i zasób.
+
+Warstwa portalu (ORM) nad czystą logiką z `aed_opis.py`. Zbiór rozpoznajemy po `customfields` (bez migracji):
+`standard = AED`, `opis_xml` = adres opisu, `md5` = suma CSV z ostatniego importu. Powtórny import tego samego opisu
+nic nie zmienia, gdy md5 jest takie samo; gdy się zmieniło, zasób CSV jest zastępowany nowym.
+"""
+
+import datetime
+import logging
+from typing import Any, Dict, List, Optional
+
+import requests
+from django.apps import apps
+from django.db import transaction
+
+from mcod.resources.aed_constants import (
+    AED_CUSTOMFIELD_STANDARD_KEY,
+    AED_CUSTOMFIELD_STANDARD_VALUE,
+)
+from mcod.resources.aed_opis import AEDCsvInvalid, inspect_csv, md5_hex, parse_opis, verify_md5
+from mcod.resources.aed_xml import AEDXmlInvalid
+from mcod.resources.dga_utils import request_remote_dga
+
+logger = logging.getLogger("mcod")
+CUSTOMFIELD_OPIS = "opis_xml"
+CUSTOMFIELD_MD5 = "md5"
+
+
+class AEDImportError(Exception):
+    """Import odrzucony; nic nie zostało zapisane w portalu."""
+
+
+def fetch_bytes(url: str, what: str) -> bytes:
+    """Pobranie pliku od dostawcy: wymagany https i kod 200, brak odpowiedzi to błąd z powodem, a nie wyjątek sieciowy."""
+    if not url.startswith("https://"):
+        raise AEDImportError(f"{what}: portal przyjmuje tylko adresy https ({url})")
+    try:
+        response = request_remote_dga(url)
+    except requests.exceptions.RequestException as exc:
+        raise AEDImportError(f"{what}: serwer dostawcy nie odpowiada ({exc})") from exc
+    if response.status_code != 200:
+        raise AEDImportError(f"{what}: serwer dostawcy zwrócił kod {response.status_code}")
+    return response.content
+
+
+def prepare_import(opis_url: str, aggregated_at: Optional[str] = None) -> Dict[str, Any]:
+    """Kroki bez zapisu: opis, XSD, CSV, md5, kontrola kolumn i duplikatów. Zwraca opis, CSV i raport kontroli."""
+    try:
+        opis = parse_opis(fetch_bytes(opis_url, "opis zbioru"))
+    except AEDXmlInvalid as exc:
+        raise AEDImportError(f"opis zbioru niezgodny z XSD: {exc}") from exc
+    resource = opis["zasob"]
+    csv_content = fetch_bytes(resource["link_csv"], "plik CSV")
+    if not verify_md5(csv_content, resource["md5"]):
+        raise AEDImportError(f"suma md5 pliku CSV ({md5_hex(csv_content)}) różni się od sumy w opisie ({resource['md5']})")
+    source = {
+        "institution_id": 0,
+        "publisher": opis["dysponent_nazwa"],
+        "license": opis["licencja"],
+        "resource_id": 0,
+        "url": opis_url,
+        "data_date": opis["data_aktualizacji"][:10],
+        "personal_data": False,
+    }
+    try:
+        report = inspect_csv(csv_content, source, aggregated_at or datetime.datetime.now().replace(microsecond=0).isoformat())
+    except AEDCsvInvalid as exc:
+        raise AEDImportError(str(exc)) from exc
+    return {"opis": opis, "md5": resource["md5"], "kontrola": report}
+
+
+def _find_dataset(opis_url: str):
+    Dataset = apps.get_model("datasets", "Dataset")
+    return Dataset.objects.filter(customfields__contains={CUSTOMFIELD_OPIS: opis_url}).first()
+
+
+def _create_resource(dataset, opis: Dict[str, Any], user):
+    Resource = apps.get_model("resources", "Resource")
+    zasob = opis["zasob"]
+    return Resource.objects.create(
+        title=zasob["tytul"],
+        description=f"{zasob['tytul']}. Plik CSV zgodny ze wzorcem AED, suma md5 {zasob['md5']} sprawdzona przy imporcie.",
+        dataset=dataset,
+        link=zasob["link_csv"],
+        type="file",
+        status="published",
+        data_date=datetime.date.fromisoformat(opis["data_aktualizacji"][:10]),
+        has_dynamic_data=False,
+        has_high_value_data=False,
+        has_high_value_data_from_ec_list=False,
+        has_research_data=False,
+        created_by=user,
+    )
+
+
+def import_dataset(opis_url: str, organization, user=None) -> Dict[str, Any]:
+    """Pełny import. Zwraca {"status": utworzono|zaktualizowano|bez_zmian, "zbior", "zasob", "kontrola"}."""
+    Dataset = apps.get_model("datasets", "Dataset")
+    Category = apps.get_model("categories", "Category")
+    prepared = prepare_import(opis_url)
+    opis, md5 = prepared["opis"], prepared["md5"]
+    customfields = {
+        AED_CUSTOMFIELD_STANDARD_KEY: AED_CUSTOMFIELD_STANDARD_VALUE,
+        CUSTOMFIELD_OPIS: opis_url,
+        CUSTOMFIELD_MD5: md5,
+    }
+    license_chosen = Dataset.LICENSE_CC0 if opis["licencja"] == "CC0 1.0" else Dataset.LICENSE_CC_BY
+    with transaction.atomic():
+        dataset = _find_dataset(opis_url)
+        if dataset is not None and (dataset.customfields or {}).get(CUSTOMFIELD_MD5) == md5:
+            current = dataset.resources.order_by("-pk").values_list("pk", flat=True).first()
+            return {"status": "bez_zmian", "zbior": dataset.pk, "zasob": current, "kontrola": prepared["kontrola"]}
+        status = "zaktualizowano" if dataset is not None else "utworzono"
+        if dataset is None:
+            dataset = Dataset.objects.create(
+                title=opis["tytul"],
+                notes=opis["opis"],
+                organization=organization,
+                customfields=customfields,
+                license_chosen=license_chosen,
+                update_frequency=opis["czestotliwosc_aktualizacji"],
+                status="published",
+                created_by=user,
+            )
+            category = Category.objects.filter(title="Zdrowie").first()
+            if category:
+                dataset.categories.add(category)
+        else:
+            for old in dataset.resources.all():
+                old.delete()
+            dataset.title, dataset.notes, dataset.license_chosen = opis["tytul"], opis["opis"], license_chosen
+            dataset.update_frequency = opis["czestotliwosc_aktualizacji"]
+            dataset.customfields = customfields
+            dataset.save()
+        resource = _create_resource(dataset, opis, user)
+    logger.info("Import AED %s: zbiór %s, zasób %s, md5 %s", status, dataset.pk, resource.pk, md5)
+    return {"status": status, "zbior": dataset.pk, "zasob": resource.pk, "kontrola": prepared["kontrola"]}
+
+
+def refresh_imported_datasets() -> List[Dict[str, Any]]:
+    """
+    Ponowny import wszystkich zbiorów zaczytanych wcześniej z opisu XML (`customfields.opis_xml`): opis, XSD, CSV, md5.
+    Ta sama suma md5 nic nie zmienia, nowa zastępuje zasób; odrzucony import zostawia zbiór bez zmian.
+    Wspólna logika komendy `import_aed_xml --odswiez` i nocnego zadania `refresh_aed_opis_task`.
+    Zwraca listę {"url", "status", "zbior", "zasob"}; przy odrzuceniu status to „odrzucono”, a powód jest w "blad".
+    """
+    Dataset = apps.get_model("datasets", "Dataset")
+    results = []
+    for dataset in Dataset.objects.filter(customfields__has_key=CUSTOMFIELD_OPIS).order_by("pk"):
+        url = dataset.customfields[CUSTOMFIELD_OPIS]
+        try:
+            result = import_dataset(url, dataset.organization)
+        except AEDImportError as exc:
+            logger.warning("Odświeżenie opisu AED %s odrzucone, zbiór %s bez zmian: %s", url, dataset.pk, exc)
+            results.append({"url": url, "status": "odrzucono", "zbior": dataset.pk, "zasob": None, "blad": str(exc)})
+            continue
+        results.append({"url": url, "status": result["status"], "zbior": result["zbior"], "zasob": result["zasob"]})
+    return results
diff --git a/portal/backend/mcod/resources/aed_opis.py b/portal/backend/mcod/resources/aed_opis.py
new file mode 100644
index 0000000..0de6d33
--- /dev/null
+++ b/portal/backend/mcod/resources/aed_opis.py
@@ -0,0 +1,74 @@
+"""
+Opis zbioru AED w XML (struktura opisu datasetu + link do CSV + suma md5): walidacja, parsowanie i kontrola pliku CSV.
+
+Moduł nie importuje Django ani ORM, więc działa też w `demo/sprawdz.py`. Kolejność importu (wykonuje ją
+komenda `import_aed_xml`): opis → walidacja XSD → pobranie CSV → zgodność md5 → kontrola kolumn i duplikatów → zapis.
+Schemat `aed_opis_zbioru.xsd` jest kopią `format_danych/schemat/aed_opis_zbioru.xsd` (pilnuje tego test).
+"""
+
+import hashlib
+from pathlib import Path
+from typing import Any, Dict
+
+from mcod.resources.aed_aggregation import (
+    build_aggregate_rows,
+    missing_minimum_columns,
+    read_tabular_bytes,
+    rename_with_aliases,
+)
+from mcod.resources.aed_dedup import deduplicate_rows
+from mcod.resources.aed_xml import AEDXmlInvalid, _parse, validate_aed_xml
+
+OPIS_XSD_PATH = Path(__file__).resolve().parent / "aed_opis_zbioru.xsd"
+
+
+class AEDCsvInvalid(Exception):
+    pass
+
+
+def validate_opis_xml(content: bytes) -> Dict[str, Any]:
+    """Raport walidacji opisu: {"valid", "errors": [{"line", "field", "message"}]} (pola jak w `validate_aed_xml`)."""
+    report = validate_aed_xml(content, str(OPIS_XSD_PATH))
+    report["records"] = 1 if report["valid"] else 0
+    return report
+
+
+def parse_opis(content: bytes) -> Dict[str, Any]:
+    """Wartości opisu jako słownik (`zasob` zagnieżdżony). Niezgodny z XSD: AEDXmlInvalid."""
+    report = validate_opis_xml(content)
+    if not report["valid"]:
+        raise AEDXmlInvalid(report["errors"])
+    root = _parse(content).getroot()
+    result: Dict[str, Any] = {}
+    for child in root:
+        if child.tag == "zasob":
+            result["zasob"] = {item.tag: (item.text or "").strip() for item in child}
+        else:
+            result[child.tag] = (child.text or "").strip()
+    result["zasob"]["md5"] = result["zasob"]["md5"].lower()
+    return result
+
+
+def md5_hex(content: bytes) -> str:
+    return hashlib.md5(content).hexdigest()  # noqa: S303 suma kontrolna pliku, nie zabezpieczenie kryptograficzne
+
+
+def verify_md5(content: bytes, expected: str) -> bool:
+    return md5_hex(content) == expected.strip().lower()
+
+
+def inspect_csv(content: bytes, source: Dict[str, Any], aggregated_at: str) -> Dict[str, Any]:
+    """
+    Kontrola CSV przed zapisem: czy ma kolumny minimum wzorca i ile wierszy przejdzie agregację oraz deduplikację.
+    Zwraca {"wiersze", "przyjete", "pominiete", "duplikaty": [...]}; brak kolumn minimum: AEDCsvInvalid.
+    """
+    try:
+        df = read_tabular_bytes(content, "csv")
+    except Exception as exc:
+        raise AEDCsvInvalid(f"nie można odczytać CSV: {exc}") from exc
+    missing = missing_minimum_columns(rename_with_aliases(df)[0].columns)
+    if missing:
+        raise AEDCsvInvalid(f"w CSV brakuje kolumn: {', '.join(missing)}")
+    rows, skipped = build_aggregate_rows(df, source, aggregated_at)
+    deduplicated, duplicates = deduplicate_rows(rows)
+    return {"wiersze": len(df), "przyjete": len(deduplicated), "pominiete": len(skipped), "duplikaty": duplicates}
