+    resource = make_resource(7, ckan=True)
+    with patch("mcod.resources.aed_utils.request_remote_dga", side_effect=requests.exceptions.ConnectTimeout("timeout")):
+        _, stats = create_main_aed_df([resource], AGGREGATED_AT)
