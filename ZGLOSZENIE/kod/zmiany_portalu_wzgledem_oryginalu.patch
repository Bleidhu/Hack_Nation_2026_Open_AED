+
+@pytest.mark.feat_main_aed
+def test_create_main_aed_df_with_mocks():
+    rows = [
+        {
+            "nazwa": "Ratusz",
+            "miejscowosc": "Legionowo",
+            "szerokosc_geograficzna": "52.4",
