+        "zasoby_pominiete": [
+            {"resource_id": 2, "powod": "nie można odczytać danych tabelarycznych: uszkodzony plik"},
+            {"resource_id": 3, "powod": "brak kolumn: miejscowosc, szerokosc_geograficzna, dlugosc_geograficzna"},
