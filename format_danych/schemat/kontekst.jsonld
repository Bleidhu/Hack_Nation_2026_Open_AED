{
  "@context": {
    "schema": "https://schema.org/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "aed": "https://dane.gov.pl/aed/def#",
    "id_aed": "@id",
    "nazwa_lokalizacji": "schema:name",
    "opis_lokalizacji": "schema:description",
    "szerokosc_geograficzna": {
      "@id": "schema:latitude",
      "@type": "xsd:decimal"
    },
    "dlugosc_geograficzna": {
      "@id": "schema:longitude",
      "@type": "xsd:decimal"
    },
    "miejscowosc": "schema:addressLocality",
    "kod_pocztowy": "schema:postalCode",
    "nazwa_ulicy": "schema:streetAddress",
    "kondygnacja": "schema:floorLevel",
    "godziny_dostepnosci": "schema:openingHours",
    "dysponent_nazwa": "schema:provider",
    "telefon_kontaktowy": "schema:telephone",
    "email_kontaktowy": "schema:email",
    "producent": "schema:manufacturer",
    "model": "schema:model",
    "data_aktualizacji": {
      "@id": "schema:dateModified",
      "@type": "xsd:dateTime"
    },
    "data_weryfikacji": {
      "@id": "aed:dataWeryfikacji",
      "@type": "xsd:date"
    },
    "typ_dostepu": "aed:typDostepu",
    "dostepny_24_7": {
      "@id": "aed:dostepny247",
      "@type": "xsd:boolean"
    },
    "zabezpieczenie": "aed:zabezpieczenie",
    "status_urzadzenia": "aed:statusUrzadzenia",
    "poziom_weryfikacji": "aed:poziomWeryfikacji",
    "zrodlo_danych": "aed:zrodloDanych",
    "kod_terc": "aed:kodTERC",
    "wymaga_przegladu": {
      "@id": "aed:wymagaPrzegladu",
      "@type": "xsd:boolean"
    },
    "wydawca_zasobu": "schema:publisher",
    "licencja_zasobu": "schema:license",
    "url_zasobu_zrodlowego": {
      "@id": "schema:isBasedOn",
      "@type": "@id"
    },
    "data_agregacji": {
      "@id": "schema:dateCreated",
      "@type": "xsd:dateTime"
    }
  }
}
